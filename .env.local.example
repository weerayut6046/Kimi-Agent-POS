# Copy this file to .env.local. Never commit the real values.
LOCAL_POSTGRES_PORT=54329
LOCAL_APP_PORT=3010
LOCAL_POSTGRES_PASSWORD=replace-with-a-long-local-database-password
LOCAL_APP_SECRET=replace-with-at-least-32-random-characters
LOCAL_ADMIN_PASSWORD=ChangeMe1234!

# Optional: point development at PostgreSQL running on another private server.
# LOCAL_DATABASE_URL=postgresql://pumppos:password@192.168.1.20:5432/pumppos
