# Copy this file to .env.local. Never commit the real values.
LOCAL_POSTGRES_PORT=54329
LOCAL_APP_PORT=3010
LOCAL_POSTGRES_PASSWORD=replace-with-a-long-local-database-password
LOCAL_APP_SECRET=replace-with-at-least-32-random-characters

# Each deployment uses its own database and Auth project. Existing POS stays business.
PUMPPOS_DEPLOYMENT_MODE=business

# Optional in local development; required for first-owner setup in production.
# Set privately on the server, using at least 32 random characters. Never use VITE_*.
# PUMPPOS_INSTALLATION_CODE=replace-with-a-private-random-installation-code

# Optional: public web origin encoded in the customer loyalty QR when the POS
# runs from desktop/localhost. Omit on the hosted web app to use its own origin.
# VITE_PUBLIC_APP_URL=https://pos.example.com

# Optional: point development at PostgreSQL running on another private server.
# LOCAL_DATABASE_URL=postgresql://pumppos:password@192.168.1.20:5432/pumppos
